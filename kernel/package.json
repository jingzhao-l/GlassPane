{
  "name": "@iterate/kernel",
  "version": "1.16.2",
  "private": true,
  "description": "iterate ecosystem shared kernel: schema truth source + dual-language contracts (Phase A)",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./canonical-json": {
      "types": "./dist/canonical-json.d.ts",
      "default": "./dist/canonical-json.js"
    },
    "./convergence": {
      "types": "./dist/convergence.d.ts",
      "default": "./dist/convergence.js"
    },
    "./decision-log": {
      "types": "./dist/decision-log.d.ts",
      "default": "./dist/decision-log.js"
    },
    "./decision-log-entry": {
      "types": "./dist/decision-log-entry.d.ts",
      "default": "./dist/decision-log-entry.js"
    },
    "./decision-log-transcribe": {
      "types": "./dist/decision-log-transcribe.d.ts",
      "default": "./dist/decision-log-transcribe.js"
    },
    "./dimension-context": {
      "types": "./dist/dimension-context.d.ts",
      "default": "./dist/dimension-context.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./evidence-decision": {
      "types": "./dist/evidence-decision.d.ts",
      "default": "./dist/evidence-decision.js"
    },
    "./evidence-pack": {
      "types": "./dist/evidence-pack.d.ts",
      "default": "./dist/evidence-pack.js"
    },
    "./index": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./invariant-report": {
      "types": "./dist/invariant-report.d.ts",
      "default": "./dist/invariant-report.js"
    },
    "./parse": {
      "types": "./dist/parse.d.ts",
      "default": "./dist/parse.js"
    },
    "./provider-registration": {
      "types": "./dist/provider-registration.d.ts",
      "default": "./dist/provider-registration.js"
    },
    "./recipe-config": {
      "types": "./dist/recipe-config.d.ts",
      "default": "./dist/recipe-config.js"
    },
    "./run-plan": {
      "types": "./dist/run-plan.d.ts",
      "default": "./dist/run-plan.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "fixtures",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "ajv": "8.20.0",
    "typescript": "5.9.3"
  }
}
