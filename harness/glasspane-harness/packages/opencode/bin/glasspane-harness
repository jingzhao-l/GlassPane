#!/usr/bin/env node

const childProcess = require("child_process")
const fs = require("fs")
const path = require("path")
const os = require("os")

const forwardedSignals = ["SIGINT", "SIGTERM", "SIGHUP"]

function run(target) {
  const child = childProcess.spawn(target, process.argv.slice(2), {
    stdio: "inherit",
  })

  child.on("error", (error) => {
    console.error(error.message)
    process.exit(1)
  })

  const forwarders = {}
  for (const signal of forwardedSignals) {
    forwarders[signal] = () => {
      try {
        child.kill(signal)
      } catch {
        // The child may have already exited.
      }
    }
    process.on(signal, forwarders[signal])
  }

  child.on("exit", (code, signal) => {
    for (const forwardedSignal of forwardedSignals) {
      process.removeListener(forwardedSignal, forwarders[forwardedSignal])
    }

    if (signal) {
      process.kill(process.pid, signal)
      return
    }

    process.exit(typeof code === "number" ? code : 0)
  })
}

// This shim ships as the package's `bin` and runs before anything is bundled, so it cannot
// import the one resolver product.json names (packages/core/src/flag/flag.ts's read()). It
// applies that resolver's rule by hand for the single variable a launcher needs — product
// name first, legacy name second — and the duplication is bounded to exactly these two
// names: harness/tools/product-surface.mjs's `env-resolution-point` rule fails if any file
// outside flag.ts reads a legacy-named variable without the product name in front of it.
const PRODUCT_BIN_PATH = "GLASSPANE_HARNESS_BIN_PATH"
const LEGACY_BIN_PATH = "OPENCODE_BIN_PATH"
const envPath = process.env[PRODUCT_BIN_PATH] ?? process.env[LEGACY_BIN_PATH]

const scriptPath = fs.realpathSync(__filename)
const scriptDir = path.dirname(scriptPath)

//
const cached = path.join(scriptDir, ".glasspane-harness")

const platformMap = {
  darwin: "darwin",
  linux: "linux",
  win32: "windows",
}
const archMap = {
  x64: "x64",
  arm64: "arm64",
  arm: "arm",
}

let platform = platformMap[os.platform()]
if (!platform) {
  platform = os.platform()
}
let arch = archMap[os.arch()]
if (!arch) {
  arch = os.arch()
}
// Product identity lives in product.json at the repo root; product-surface.mjs
// keeps these three constants in step with it (this shim ships without the file).
const base = "glasspane-harness-" + platform + "-" + arch
const binary = platform === "windows" ? "glasspane-harness.exe" : "glasspane-harness"

// The installable platform packages are the target matrix, never an enumeration of possible
// suffixes — same rule as script/postinstall.mjs. product.json holds the matrix and script/
// publish.ts seals it into the wrapper's optionalDependencies (its --dry-run refuses a
// wrapper whose list disagrees), so both copies name the same declared set by construction.
// The product.json path follows script/build.ts's convention (fork root, three directories
// above), which holds in this repo checkout and in installer-selftest fixtures; inside an
// installed wrapper the shim sits in bin/, so the adjacent package.json one directory up is
// the matrix's only surviving copy there. A foreign product.json reached the same way is
// rejected by the name check, never obeyed.
const wrapperManifestPath = path.join(scriptDir, "..", "package.json")
// Read once: a repo checkout has `packages/opencode/package.json` (whose name matches
// product.json's), an installed wrapper has the sealed manifest, and neither read is guaranteed.
// An unreadable one is the empty object, so it cannot prove any name installable — the refusal
// text then says plainly that no build is declared instead of pointing at packages that may not
// exist — and every rule below that needs a claim out of it fails closed.
const wrapperManifest = (() => {
  try {
    return JSON.parse(fs.readFileSync(wrapperManifestPath, "utf8"))
  } catch {
    return {}
  }
})()
const declaredNames = (() => {
  const namesFromMatrix = (product) =>
    product.platformTargets.map((target) =>
      [
        product.name,
        target.os === "win32" ? "windows" : target.os,
        target.arch,
        target.avx2 === false ? "baseline" : undefined,
        target.abi ?? undefined,
      ]
        .filter(Boolean)
        .join("-"),
    )
  try {
    const parsed = JSON.parse(fs.readFileSync(path.join(scriptDir, "..", "..", "..", "product.json"), "utf8"))
    if (Array.isArray(parsed.platformTargets) && parsed.platformTargets.length > 0) {
      const wrapperName = wrapperManifest.name
      if (!wrapperName || parsed.name === wrapperName) return namesFromMatrix(parsed)
    }
  } catch {
    // not in a repo checkout — fall through to the sealed manifest
  }
  return Object.keys(wrapperManifest.optionalDependencies ?? {})
})()

// The version this wrapper seals for each declared platform package. script/publish.ts writes this
// map and its --dry-run refuses a wrapper whose list disagrees, so it is the claim npm resolved for
// THIS install — the same one script/postinstall.mjs's `resolveBinary()` checks a candidate's own
// manifest against. A name with no sealed version has nothing to check against, so no copy of it
// can be loaded here either.
const sealedVersions = wrapperManifest.optionalDependencies ?? {}

function supportsAvx2() {
  if (arch !== "x64") return false

  if (platform === "linux") {
    try {
      return /(^|\s)avx2(\s|$)/i.test(fs.readFileSync("/proc/cpuinfo", "utf8"))
    } catch {
      return false
    }
  }

  if (platform === "darwin") {
    try {
      const result = childProcess.spawnSync("sysctl", ["-n", "hw.optional.avx2_0"], {
        encoding: "utf8",
        timeout: 1500,
      })
      if (result.status !== 0) return false
      return (result.stdout || "").trim() === "1"
    } catch {
      return false
    }
  }

  if (platform === "windows") {
    const cmd =
      '(Add-Type -MemberDefinition "[DllImport(""kernel32.dll"")] public static extern bool IsProcessorFeaturePresent(int ProcessorFeature);" -Name Kernel32 -Namespace Win32 -PassThru)::IsProcessorFeaturePresent(40)'

    for (const exe of ["powershell.exe", "pwsh.exe", "pwsh", "powershell"]) {
      try {
        const result = childProcess.spawnSync(exe, ["-NoProfile", "-NonInteractive", "-Command", cmd], {
          encoding: "utf8",
          timeout: 3000,
          windowsHide: true,
        })
        if (result.status !== 0) continue
        const out = (result.stdout || "").trim().toLowerCase()
        if (out === "true" || out === "1") return true
        if (out === "false" || out === "0") return false
      } catch {
        continue
      }
    }

    return false
  }

  return false
}

const machine = (() => {
  const avx2 = supportsAvx2()
  const baseline = arch === "x64" && !avx2

  const musl = (() => {
    if (platform !== "linux") return false

    try {
      if (fs.existsSync("/etc/alpine-release")) return true
    } catch {
      // ignore
    }

    try {
      const result = childProcess.spawnSync("ldd", ["--version"], { encoding: "utf8" })
      const text = ((result.stdout || "") + (result.stderr || "")).toLowerCase()
      if (text.includes("musl")) return true
    } catch {
      // ignore
    }

    return false
  })()

  const candidates = (() => {
    if (platform === "linux") {
      if (musl) {
        if (arch === "x64") {
          if (baseline) return [`${base}-baseline-musl`, `${base}-musl`, `${base}-baseline`, base]
          return [`${base}-musl`, `${base}-baseline-musl`, base, `${base}-baseline`]
        }
        return [`${base}-musl`, base]
      }

      if (arch === "x64") {
        if (baseline) return [`${base}-baseline`, base, `${base}-baseline-musl`, `${base}-musl`]
        return [base, `${base}-baseline`, `${base}-musl`, `${base}-baseline-musl`]
      }
      return [base, `${base}-musl`]
    }

    if (arch === "x64") {
      if (baseline) return [`${base}-baseline`, base]
      return [base, `${base}-baseline`]
    }
    return [base]
  })()

  // Only a declared package is installable on this product, and a no-AVX2 x64 machine can only
  // run a baseline build (product.json platform.dropped records that darwin-x64-baseline was
  // dropped by decision — the old text named it to users anyway, a remedy that can never work).
  // An empty list means "this machine has no build to install"; the refusal below says so.
  const installable = candidates.filter((name) => {
    if (!declaredNames.includes(name)) return false
    return !baseline || name.endsWith("-baseline") || name.endsWith("-baseline-musl")
  })

  const here = `${platform}-${arch}${musl ? "-musl" : ""}${baseline ? " without AVX2" : ""}`
  const supported = declaredNames.length
    ? "The builds it does publish are " + declaredNames.map((name) => `"${name}"`).join(", ") + "."
    : "This wrapper declares no platform packages at all."
  const refusal = `glasspane-harness does not ship a build for your platform (${here}). ${supported}`

  return { installable, refusal }
})()

const names = machine.installable

// What this launcher may exec, under the rule script/postinstall.mjs's `resolveBinary()` already
// applies. Its comment block above `installTrees()` records the measured hazard: the search that
// walked every `node_modules` ABOVE the wrapper — out of the project, through the home directory,
// to `/` — let a planted package satisfy it, and the only statement then made about the bytes was a
// `--version` string equality a 3-line shell script answers. That fix stopped at the installer and
// left this shim, the other half of the same channel (it is what execs the bytes for every
// `glasspane-harness` command), with the weak walk. Two statements, neither self-reported by the
// candidate:
//  1. the directory is inside this wrapper's own install tree — its nested `node_modules`, or the
//     boundary `node_modules` of the wrapper's realpath — and nothing above it,
//  2. the directory's own manifest names this platform package at the exact version this wrapper
//     seals, which is a claim about the package made by the manifest npm resolved here.
// Every copy that is skipped is recorded with the statement it failed, so the reader can tell "not
// installed" from "this launcher refused a planted copy". The install-record third statement is the
// installer's half; this shim ships no reader for it and is bounded by these two.
const refused = []

function installTrees(own) {
  const nestedTree = path.join(own, "node_modules")
  const segments = own.split(path.sep)
  let boundary = null
  for (let index = 1; index < segments.length; index++) {
    if (segments[index] === "node_modules") boundary = segments.slice(0, index + 1).join(path.sep)
  }
  return { nestedTree, boundary }
}

function candidateDirs(wrapperDir, name) {
  const dirs = [path.join(wrapperDir, "node_modules", name)]
  const parent = path.dirname(wrapperDir)
  if (path.basename(parent) === "node_modules") dirs.push(path.join(parent, name))
  return dirs
}

function findBinary(wrapperDir) {
  const { nestedTree, boundary } = installTrees(wrapperDir)
  for (const name of names) {
    const sealed = sealedVersions[name]
    for (const dir of candidateDirs(wrapperDir, name)) {
      if (!fs.existsSync(dir)) continue
      let real
      try {
        real = fs.realpathSync(dir)
      } catch (error) {
        refused.push(`${dir}: unreadable (${readReason(error)})`)
        continue
      }
      const inside = (tree) => tree !== null && (real === tree || real.startsWith(tree + path.sep))
      if (!inside(boundary) && !inside(nestedTree)) {
        refused.push(`${real} is not inside this install (${boundary ?? nestedTree})`)
        continue
      }
      if (sealed === undefined) {
        refused.push(`${real}: this wrapper seals no version for ${name} in its optionalDependencies`)
        continue
      }
      let manifest
      try {
        manifest = JSON.parse(fs.readFileSync(path.join(dir, "package.json"), "utf8"))
      } catch (error) {
        refused.push(`${real}: no readable package.json (${readReason(error)})`)
        continue
      }
      if (manifest.name !== name) {
        refused.push(`${real}: its package.json names ${JSON.stringify(manifest.name)}, not ${name}`)
        continue
      }
      if (manifest.version !== sealed) {
        refused.push(`${real} is ${manifest.name}@${manifest.version}, this wrapper seals ${sealed}`)
        continue
      }
      const candidate = path.join(dir, "bin", binary)
      if (!fs.existsSync(candidate)) {
        refused.push(`${real} has no bin/${binary}`)
        continue
      }
      return candidate
    }
  }
}

/**
 * The environment names a file to exec directly, so it gets the same kind of screen — four
 * statements, none of them answered by the file itself: an absolute path, a leaf that `lstat` (not
 * `stat`, which follows the link exactly as the exec does) calls a REGULAR file, owned by this
 * process's uid where a uid is knowable, and not writable by group or world. Measured 2026-11-06:
 * a group-writable path is one write by anyone in that class away from being someone else's bytes,
 * and a pre-positioned symlink moves every claim here onto the file at its other end. Both the
 * product's own name and the legacy spelling go through this one screen, so the legacy spelling
 * gains nothing it did not already have.
 */
function overrideRefusal(value) {
  if (!path.isAbsolute(value)) return "is not an absolute path"
  let leaf
  try {
    leaf = fs.lstatSync(value)
  } catch (error) {
    return `has no readable leaf (${readReason(error)})`
  }
  if (leaf.isSymbolicLink()) return `is a symbolic link to ${linkTarget(value)}; nothing is followed through it`
  if (!leaf.isFile()) return `is not a regular file`
  if (typeof process.geteuid === "function" && leaf.uid !== process.geteuid()) {
    return `is owned by uid ${leaf.uid}, not uid ${process.geteuid()}`
  }
  if ((leaf.mode & 0o022) !== 0) return `is writable by group or world (mode ${(leaf.mode & 0o777).toString(8)})`
}

function readReason(error) {
  return error instanceof Error ? error.message : String(error)
}

function linkTarget(value) {
  try {
    return fs.readlinkSync(value)
  } catch (error) {
    return `a target that cannot be read (${readReason(error)})`
  }
}

const override = envPath === undefined ? undefined : overrideRefusal(envPath)
if (override !== undefined) {
  console.error(`glasspane-harness refuses the binary its environment names: ${envPath} ${override}. Nothing was executed.`)
  process.exit(1)
}

const resolved = envPath ?? (fs.existsSync(cached) ? cached : findBinary(path.dirname(scriptDir)))
if (!resolved) {
  for (const reason of refused) console.error(`refused: ${reason}`)
  if (names.length === 0) {
    // Nothing on this machine is installable: state that plainly and name the supported set,
    // instead of the old text that told the reader to manually install packages this product
    // has decided (product.json platform.dropped) never to publish.
    console.error(machine.refusal)
    process.exit(1)
  }
  console.error(
    "It seems that your package manager failed to install the right version of the glasspane-harness CLI for your platform. You can try manually installing " +
      names.map((n) => `\"${n}\"`).join(" or ") +
      " package",
  )
  process.exit(1)
}

run(resolved)
