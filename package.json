{
  "name": "@glasspane/monorepo",
  "version": "1.1.1",
  "private": true,
  "description": "GlassPane monorepo: TS mcp-shell + iterate kernel + macOS Swift engine (daemon + settings GUI) + one-command installer",
  "workspaces": [
    "kernel",
    "mcp-shell",
    "installer"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build --workspace @iterate/kernel && npm run build --workspace glasspane-mcp",
    "test": "npm run build && npm run test --workspaces --if-present",
    "contracts:harness": "node harness/tools/hook-liveness.mjs --check",
    "contracts:harness:offline": "node harness/tools/hook-liveness.mjs --offline",
    "contracts:harness:probe": "node harness/tools/hook-liveness.mjs --probe",
    "contracts:surface": "node harness/tools/tool-surface.mjs --check",
    "contracts:semantics": "node harness/tools/surface-semantics.mjs --check",
    "contracts:product": "node harness/tools/product-surface.mjs --check",
    "contracts:brand": "node harness/tools/brand-surface.mjs --check",
    "install:engine": "node installer/cli.js",
    "install:engine:silent": "node installer/cli.js --no-prompt --no-gui"
  }
}